<?xml version="1.0" ?>
<!--
  SYNTHETIC TEST FIXTURE - NOT REAL SCAN DATA.

  Written by hand for the vuln-playbook tests and the dry-run demo.
  - Every IP address is from a documentation range (192.0.2.0/24,
    198.51.100.0/24, 203.0.113.0/24). These are never routed on the internet.
  - Every hostname uses the reserved .example.test domain.
  - CVE IDs are real, so the enrichers (NVD, KEV, EPSS) have something real
    to look up. Plugin IDs in the 900000 range are made up. The
    informational plugin IDs (19506, 22964, 11936, 10287) match the
    well-known Nessus plugins of the same name.

  Cases this file must cover (checked by tests/test_fixtures.py):
  - KEV-listed CVE:           CVE-2021-44228 (plugin 900104) on 192.0.2.20 and 198.51.100.20
  - Ubuntu banner-only check: plugin 900101 on 192.0.2.10 (OpenSSH version banner)
  - Informational plugins:    19506, 22964, 11936, 10287 (severity 0)
  - Duplicate CVE:            CVE-2016-2183 in plugins 900102 and 900105
  - Out-of-scope host:        203.0.113.50 (outside every include range)
  - Excluded host:            192.0.2.250 (inside include, but listed in exclude)
  - Pass-2-only host:         192.0.2.30 (missed by Nmap pass 1, found by the -Pn sweep;
                              informational results only)
-->
<NessusClientData_v2>
<Policy>
<policyName>Internal Basic Network Scan</policyName>
</Policy>
<Report name="Example Corp dry run" xmlns:cm="http://www.nessus.org/cm">

<!-- ===================================================================== -->
